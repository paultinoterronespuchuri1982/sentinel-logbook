# Copy this file to .env and fill in your values. Never commit .env.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: model name (default: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
# Optional: comma-separated origins allowed to call the API from a browser
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional: bind address and port (default 127.0.0.1:8000)
HOST=127.0.0.1
PORT=8000
