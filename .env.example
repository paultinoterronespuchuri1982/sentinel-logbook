# Copie para .env e preencha os valores. Nunca versione o arquivo .env.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modelo usado para gerar os relatórios
CLAUDE_MODEL=claude-opus-5-5

# Máximo de relatórios por minuto para cada IP
RATE_LIMIT_PER_MINUTE=10

# Origens autorizadas para chamadas de outro site (separadas por vírgula). Vazio = só a própria UI.
ALLOWED_ORIGINS=

# Endereço de escuta. Use 0.0.0.0 apenas se precisar acessar de outra máquina.
HOST=127.0.0.1
PORT=8000
